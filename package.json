{
  "name": "nexon-open-api",
  "version": "0.1.1",
  "description": "Type-safe Nexon Open API SDK for MapleStory, FC Online, and more — zero dependencies",
  "author": "Kimhasa",
  "license": "MIT",
  "keywords": [
    "nexon",
    "nexon-api",
    "nexon-open-api",
    "maplestory",
    "maplestory-m",
    "maplestory-sea",
    "fc-online",
    "sdk",
    "typescript",
    "api-wrapper",
    "game-api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kimhasa/nexon-open-api-sdk.git"
  },
  "homepage": "https://github.com/Kimhasa/nexon-open-api-sdk#readme",
  "bugs": {
    "url": "https://github.com/Kimhasa/nexon-open-api-sdk/issues"
  },
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./maplestory": {
      "types": "./dist/maplestory.d.ts",
      "import": "./dist/maplestory.js",
      "require": "./dist/maplestory.cjs"
    },
    "./fconline": {
      "types": "./dist/fconline.d.ts",
      "import": "./dist/fconline.js",
      "require": "./dist/fconline.cjs"
    },
    "./maplestory-m": {
      "types": "./dist/maplestory-m.d.ts",
      "import": "./dist/maplestory-m.js",
      "require": "./dist/maplestory-m.cjs"
    },
    "./maplestory-sea": {
      "types": "./dist/maplestory-sea.d.ts",
      "import": "./dist/maplestory-sea.js",
      "require": "./dist/maplestory-sea.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:maplestory": "tsx scripts/test-maplestory.ts",
    "test:maplestory-m": "tsx scripts/test-maplestory-m.ts",
    "test:fconline": "tsx scripts/test-fconline.ts",
    "test:maplestory-sea": "tsx scripts/test-maplestory-sea.ts",
    "release": "yarn build && yarn test && npm publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "^2.7.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
