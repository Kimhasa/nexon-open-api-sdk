{
  "name": "nexon-open-api",
  "version": "0.1.1",
  "description": "Type-safe Nexon Open API SDK for MapleStory, FC Online, and more — zero dependencies",
  "author": "Kimhasa",
  "license": "MIT",
  "keywords": [
    "nexon",
    "nexon-api",
    "nexon-open-api",
    "maplestory",
    "maplestory-m",
    "maplestory-sea",
    "fc-online",
    "sdk",
    "typescript",
    "api-wrapper",
    "game-api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kimhasa/nexon-open-api-sdk.git"
  },
  "homepage": "https://github.com/Kimhasa/nexon-open-api-sdk#readme",
  "bugs": {
    "url": "https://github.com/Kimhasa/nexon-open-api-sdk/issues"
  },
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./maplestory": {
      "import": {
        "types": "./dist/maplestory.d.ts",
        "default": "./dist/maplestory.js"
      },
      "require": {
        "types": "./dist/maplestory.d.cts",
        "default": "./dist/maplestory.cjs"
      }
    },
    "./fconline": {
      "import": {
        "types": "./dist/fconline.d.ts",
        "default": "./dist/fconline.js"
      },
      "require": {
        "types": "./dist/fconline.d.cts",
        "default": "./dist/fconline.cjs"
      }
    },
    "./maplestory-m": {
      "import": {
        "types": "./dist/maplestory-m.d.ts",
        "default": "./dist/maplestory-m.js"
      },
      "require": {
        "types": "./dist/maplestory-m.d.cts",
        "default": "./dist/maplestory-m.cjs"
      }
    },
    "./maplestory-sea": {
      "import": {
        "types": "./dist/maplestory-sea.d.ts",
        "default": "./dist/maplestory-sea.js"
      },
      "require": {
        "types": "./dist/maplestory-sea.d.cts",
        "default": "./dist/maplestory-sea.cjs"
      }
    },
    "./maplestory-tw": {
      "import": {
        "types": "./dist/maplestory-tw.d.ts",
        "default": "./dist/maplestory-tw.js"
      },
      "require": {
        "types": "./dist/maplestory-tw.d.cts",
        "default": "./dist/maplestory-tw.cjs"
      }
    },
    "./first-descendant": {
      "import": {
        "types": "./dist/first-descendant.d.ts",
        "default": "./dist/first-descendant.js"
      },
      "require": {
        "types": "./dist/first-descendant.d.cts",
        "default": "./dist/first-descendant.cjs"
      }
    },
    "./mabinogi-heroes": {
      "import": {
        "types": "./dist/mabinogi-heroes.d.ts",
        "default": "./dist/mabinogi-heroes.js"
      },
      "require": {
        "types": "./dist/mabinogi-heroes.d.cts",
        "default": "./dist/mabinogi-heroes.cjs"
      }
    },
    "./sudden-attack": {
      "import": {
        "types": "./dist/sudden-attack.d.ts",
        "default": "./dist/sudden-attack.js"
      },
      "require": {
        "types": "./dist/sudden-attack.d.cts",
        "default": "./dist/sudden-attack.cjs"
      }
    },
    "./kartrider": {
      "import": {
        "types": "./dist/kartrider.d.ts",
        "default": "./dist/kartrider.js"
      },
      "require": {
        "types": "./dist/kartrider.d.cts",
        "default": "./dist/kartrider.cjs"
      }
    },
    "./baram": {
      "import": {
        "types": "./dist/baram.d.ts",
        "default": "./dist/baram.js"
      },
      "require": {
        "types": "./dist/baram.d.cts",
        "default": "./dist/baram.cjs"
      }
    },
    "./mabinogi": {
      "import": {
        "types": "./dist/mabinogi.d.ts",
        "default": "./dist/mabinogi.js"
      },
      "require": {
        "types": "./dist/mabinogi.d.cts",
        "default": "./dist/mabinogi.cjs"
      }
    },
    "./baram-yeon": {
      "import": {
        "types": "./dist/baram-yeon.d.ts",
        "default": "./dist/baram-yeon.js"
      },
      "require": {
        "types": "./dist/baram-yeon.d.cts",
        "default": "./dist/baram-yeon.cjs"
      }
    },
    "./v4": {
      "import": {
        "types": "./dist/v4.d.ts",
        "default": "./dist/v4.js"
      },
      "require": {
        "types": "./dist/v4.d.cts",
        "default": "./dist/v4.cjs"
      }
    },
    "./hit2": {
      "import": {
        "types": "./dist/hit2.d.ts",
        "default": "./dist/hit2.js"
      },
      "require": {
        "types": "./dist/hit2.d.cts",
        "default": "./dist/hit2.cjs"
      }
    },
    "./platform": {
      "import": {
        "types": "./dist/platform.d.ts",
        "default": "./dist/platform.js"
      },
      "require": {
        "types": "./dist/platform.d.cts",
        "default": "./dist/platform.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check:exports": "attw --pack . --profile node16",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:maplestory": "tsx scripts/test-maplestory.ts",
    "test:maplestory-m": "tsx scripts/test-maplestory-m.ts",
    "test:fconline": "tsx scripts/test-fconline.ts",
    "test:maplestory-sea": "tsx scripts/test-maplestory-sea.ts",
    "specs:fetch": "tsx scripts/specs-fetch.ts",
    "specs:check": "tsx scripts/specs-check.ts",
    "specs:coverage": "tsx scripts/specs-coverage.ts",
    "specs:diff": "tsx scripts/specs-diff.ts",
    "specs:drift": "tsx scripts/specs-drift.ts",
    "specs:notices": "tsx scripts/specs-notices.ts",
    "release": "yarn build && yarn test && npm publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "^2.7.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
