# Nexon Open API 키 (https://openapi.nexon.com 에서 발급)
# 게임별로 별도 API 키를 사용합니다.
NEXON_MAPLESTORY_API_KEY=your_maplestory_api_key_here
NEXON_MAPLESTORY_M_API_KEY=your_maplestory_m_api_key_here
NEXON_FC_ONLINE_API_KEY=your_fc_online_api_key_here

# 메이플스토리M E2E 테스트용 (yarn test:maplestory-m)
MAPLE_M_WORLD=스카니아
MAPLE_M_CHARACTER=내캐릭터명

# FC Online E2E 테스트용 (yarn test:fconline)
FC_ONLINE_NICKNAME=내닉네임
