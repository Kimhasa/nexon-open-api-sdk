# Nexon Open API 키 (https://openapi.nexon.com 에서 발급)
# 게임별로 별도 API 키를 사용합니다.
NEXON_MAPLESTORY_API_KEY=your_maplestory_api_key_here
NEXON_MAPLESTORY_M_API_KEY=your_maplestory_m_api_key_here
NEXON_MAPLESTORY_SEA_API_KEY=your_maplestory_sea_api_key_here
NEXON_FC_ONLINE_API_KEY=your_fc_online_api_key_here
NEXON_MAPLESTORY_TW_API_KEY=your_maplestory_tw_api_key_here
NEXON_TFD_API_KEY=your_tfd_api_key_here
NEXON_HEROES_API_KEY=your_heroes_api_key_here
NEXON_SUDDEN_ATTACK_API_KEY=your_sudden_attack_api_key_here
NEXON_KARTRIDER_API_KEY=your_kartrider_api_key_here
NEXON_BARAM_API_KEY=your_baram_api_key_here
NEXON_MABINOGI_API_KEY=your_mabinogi_api_key_here
NEXON_BARAM_YEON_API_KEY=your_baram_yeon_api_key_here
NEXON_V4_API_KEY=your_v4_api_key_here
NEXON_HIT2_API_KEY=your_hit2_api_key_here
NEXON_PLATFORM_API_KEY=your_platform_api_key_here

# 메이플스토리 E2E 테스트용 (yarn test:maplestory)
MAPLESTORY_CHARACTER=내캐릭터명
MAPLESTORY_GUILD=내길드명
# 생략 시 기본값: 스카니아
MAPLESTORY_WORLD=스카니아
# 선택: 구 개발자센터 API 키. 설정하면 getLegacyOuid() 도 테스트합니다
NEXON_MAPLESTORY_LEGACY_API_KEY=

# 메이플스토리M E2E 테스트용 (yarn test:maplestory-m)
# 생략 시 기본값: 스카니아
MAPLE_M_WORLD=스카니아
MAPLE_M_CHARACTER=내캐릭터명

# MapleStorySEA E2E 테스트용 (yarn test:maplestory-sea)
MAPLESTORY_SEA_CHARACTER=YourCharacterName
# 선택: 설정하면 길드 API도 테스트합니다
MAPLESTORY_SEA_GUILD=YourGuildName
# 생략 시 기본값: Aquila
MAPLESTORY_SEA_WORLD=Aquila

# FC Online E2E 테스트용 (yarn test:fconline)
FC_ONLINE_NICKNAME=내닉네임

# MapleStory Taiwan E2E 테스트용 (yarn test:maplestory-tw)
MAPLESTORY_TW_CHARACTER=YourCharacterName
# 선택: 설정하면 길드 API도 테스트합니다
MAPLESTORY_TW_GUILD=
# 생략 시 기본값: 艾麗亞
MAPLESTORY_TW_WORLD=艾麗亞

# 퍼스트 디센던트 E2E 테스트용 (yarn test:first-descendant)
# # 뒤는 주석으로 잘리므로 태그가 있는 닉네임은 따옴표로 감싼다
TFD_USER_NAME="닉네임#1234"
# 생략 시 기본값: ko
TFD_LANGUAGE=ko

# 마비노기 영웅전 E2E 테스트용 (yarn test:mabinogi-heroes)
HEROES_CHARACTER=내캐릭터명
# 생략 시 기본값: 인챈트 스크롤
HEROES_MARKET_ITEM=인챈트 스크롤

# 서든어택 E2E 테스트용 (yarn test:sudden-attack)
SUDDEN_ATTACK_USER_NAME=내닉네임
# 생략 시 기본값: 폭파미션
SUDDEN_ATTACK_MATCH_MODE=폭파미션

# 카트라이더 러쉬플러스 E2E 테스트용 (yarn test:kartrider)
KARTRIDER_RACER_NAME=내라이더명

# 마비노기 E2E 테스트용 (yarn test:mabinogi) — API 키만 필요합니다

# 바람의나라 E2E 테스트용 (yarn test:baram)
BARAM_CHARACTER=내캐릭터명
# 생략 시 기본값: 연
BARAM_SERVER=연

# 바람의나라: 연 E2E 테스트용 (yarn test:baram-yeon)
BARAM_YEON_CHARACTER=내캐릭터명
# 생략 시 기본값: 연
BARAM_YEON_SERVER=연

# V4 E2E 테스트용 (yarn test:v4)
V4_CHARACTER=내캐릭터명

# 히트2 E2E 테스트용 (yarn test:hit2)
HIT2_CHARACTER=내캐릭터명

# 넥슨 Open API 공지 E2E 테스트용 (yarn test:platform)
# 생략 시 기본값: 메이플스토리
PLATFORM_GAME_NAME=메이플스토리
